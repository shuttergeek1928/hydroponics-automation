# ==========================================
# Root .gitignore for Hydroponics Automation
# Multi-stack repository (.NET, Node.js/Next.js, C++/Arduino)
# ==========================================

# --- OS / System files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor files ---
.vs/
.vscode/
*.user
*.suo
*.sln.docstates
*.userosscache
*.sln.targets
.idea/
*.swp
*.swo

# --- .NET Build & Publish outputs ---
[Bb]in/
[Oo]bj/
[Oo]ut/
publish/
.ekst/
*.log
*.apibuildstate

# --- Node.js / React / Next.js ---
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- ESP32 / Arduino / PlatformIO ---
# Build directories for Arduino/PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json
*.hex
*.elf
*.bin

# --- Databases / Local Storage ---
# Ignore local database files generated by EF Core / LocalDB
*.mdf
*.ldf
*.db
*.sqlite
